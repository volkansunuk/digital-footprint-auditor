@page
@model DigitalFootprintAuditor.Api.Pages.NewScanModel

@{
    ViewData["Title"] = "Yeni Tarama";
}

<section class="page-header">
    <span class="eyebrow">Yeni Analiz</span>

    <h1>Yeni Tarama Başlat</h1>

    <p>
        Alanların tamamını doldurmak zorunda değilsiniz.
        Yalnızca size ait veya analiz etmeye yetkili olduğunuz
        varlıkları giriniz.
    </p>
</section>

<section class="form-card">
    <form method="post">

        <div asp-validation-summary="ModelOnly"
            class="validation-summary">
        </div>

        <div class="form-group">
            <label asp-for="Email">E-posta</label>

            <input
                asp-for="Email"
                type="email"
                placeholder="ornek@example.com" />

            <small>
                Gravatar ve e-posta odaklı kontroller için kullanılır.
            </small>
        </div>

        <div class="form-group">
            <label asp-for="GitHubUsername">
                GitHub Kullanıcı Adı
            </label>

            <input
                asp-for="GitHubUsername"
                type="text"
                placeholder="octocat" />

            <small>
                Açık profil ve public repository kontrolleri yapılır.
            </small>
        </div>

        <div class="form-group">
            <label asp-for="Domain">Domain</label>

            <input
                asp-for="Domain"
                type="text"
                placeholder="example.com" />

            <small>
                RDAP ve DNS kontrolleri yapılır.
            </small>
        </div>

        <div class="form-group">
            <label asp-for="Website">Web Sitesi</label>

            <input
                asp-for="Website"
                type="url"
                placeholder="https://example.com" />

            <small>
                HTTPS ve güvenlik başlıkları kontrol edilir.
            </small>
        </div>

        <button
            class="button button-primary"
            type="submit">
            Taramayı Başlat
        </button>

    </form>
</section>