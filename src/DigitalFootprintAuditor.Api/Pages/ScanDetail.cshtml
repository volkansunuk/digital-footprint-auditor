@page
@model DigitalFootprintAuditor.Api.Pages.ScanDetailModel

@{
    ViewData["Title"] = "Tarama Detayı";
}

<section class="page-header">
    <span class="eyebrow">Tarama Sonucu</span>

    <h1>Tarama Detayı</h1>

    <p>
        Taramanın genel risk durumu ve scanner bulguları aşağıda
        görüntülenmektedir.
    </p>
</section>

@if (Model.Scan is not null)
{

    <form id="antiforgery-form"
        style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <section id="live-progress-section"
             class="section"
             style="display:none;">

        <div class="section-heading">
            <span class="eyebrow">Canlı İlerleme</span>
            <h2>Scanner Durumları</h2>
        </div>

        <div id="live-scanner-statuses"
             class="scanner-status-list">
        </div>
    </section>

    <section class="summary-grid">
        <article class="summary-card">
            <span>Risk Puanı</span>
            <strong>@Model.Scan.RiskScore / 100</strong>
        </article>

        <article class="summary-card">
            <span>Risk Seviyesi</span>
            <strong>@Model.Scan.RiskLevel</strong>
        </article>

        <article class="summary-card">
            <span>Durum</span>
            <strong>@Model.Scan.Status</strong>
        </article>

        <article class="summary-card">
            <span>Bulgu Sayısı</span>
            <strong>@Model.Scan.Findings.Count</strong>
        </article>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">Hedefler</span>
            <h2>Taranan Varlıklar</h2>
        </div>

        <div class="target-list">
            @foreach (var target in Model.Scan.Targets)
            {
                <div class="target-item">
                    <strong>@target.TargetType</strong>
                    <span>@target.TargetValue</span>
                </div>
            }
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">Scanner Durumları</span>
            <h2>Tamamlanan ve Başarısız Scanner'lar</h2>
        </div>

        @if (Model.Scan.ScannerStatuses.Count == 0)
        {
            <div class="empty-state">
                Scanner durumu bulunamadı.
            </div>
        }
        else
        {
            <div class="scanner-status-list">
                @foreach (var scannerStatus in Model.Scan.ScannerStatuses)
                {
                    <div class="scanner-status-item">
                        <strong>@scannerStatus.ScannerName</strong>

                        @if (scannerStatus.IsSuccessful)
                        {
                            <span class="status-badge status-success">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-failed">
                                Failed
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">Bulgular</span>
            <h2>Scanner Sonuçları</h2>
        </div>

        @if (Model.Scan.Findings.Count == 0)
        {
            <div class="empty-state">
                Bu taramada herhangi bir bulgu üretilmedi.
            </div>
        }
        else
        {
            <div class="findings-list">
                @foreach (var finding in Model.Scan.Findings)
                {
                    <article class="finding-card">
                        <div class="finding-header">
                            <div>
                                <span class="scanner-name">
                                    @finding.ScannerName
                                </span>

                                <h3>@finding.Title</h3>
                            </div>

                            <span class="severity-badge">
                                @finding.Severity
                            </span>
                        </div>

                        <p>
                            @finding.Description
                        </p>

                        <div class="recommendation">
                            <strong>Önerilen Aksiyon</strong>
                            <p>@finding.Recommendation</p>
                        </div>

                        <div class="finding-meta">
                            <span>
                                Risk katkısı:
                                <strong>+@finding.ScoreImpact</strong>
                            </span>

                            <span>
                                Kaynak:
                                <strong>@finding.Source</strong>
                            </span>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}
else
{
    <div class="empty-state">
        <h2>Görüntülenecek bir tarama seçilmedi.</h2>

        <p>
            Tarama detaylarını görmek için yeni bir tarama başlatabilir
            veya tarama geçmişinden mevcut bir taramayı seçebilirsiniz.
        </p>

        <div class="hero-actions">
            <a class="button button-primary"
               asp-page="/NewScan">
                Yeni Tarama Başlat
            </a>

            <a class="button button-secondary"
               asp-page="/ScanHistory">
                Tarama Geçmişine Git
            </a>
        </div>
    </div>
}

@if (Model.Scan is not null)
{
    <script src="~/lib/signalr/signalr.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const scanId = "@Model.Scan.Id";

            const urlParams =
                new URLSearchParams(window.location.search);

            const shouldStart =
                (urlParams.get("start") ?? "")
                .toLowerCase() === "true";

            if (!shouldStart) {
                return;
            }

            const progressSection =
                document.getElementById(
                    "live-progress-section");

            const statusContainer =
                document.getElementById(
                    "live-scanner-statuses");

            progressSection.style.display = "block";

            const scannerElements = new Map();

            const connection =
                new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/scan-progress")
                    .withAutomaticReconnect()
                    .build();

            connection.on(
                "ScannerProgressUpdated",
                function (progress) {
                    updateScannerStatus(progress);
                });

            function updateScannerStatus(progress) {
                const scannerName =
                    progress.scannerName;

                const status =
                    progress.status;

                let row =
                    scannerElements.get(scannerName);

                if (!row) {
                    row = document.createElement("div");
                    row.className =
                        "scanner-status-item";

                    const nameElement =
                        document.createElement("strong");

                    nameElement.textContent =
                        scannerName;

                    const statusElement =
                        document.createElement("span");

                    statusElement.className =
                        "status-badge";

                    row.appendChild(nameElement);
                    row.appendChild(statusElement);

                    statusContainer.appendChild(row);

                    scannerElements.set(
                        scannerName,
                        row);
                }

                const statusElement =
                    row.querySelector(".status-badge");

                statusElement.textContent =
                    status;

                statusElement.className =
                    "status-badge";

                if (status === "Completed") {
                    statusElement.classList.add(
                        "status-success");
                }
                else if (status === "Failed") {
                    statusElement.classList.add(
                        "status-failed");
                }
                else {
                    statusElement.classList.add(
                        "status-running");
                }
            }

            try {
                await connection.start();

                await connection.invoke(
                    "JoinScanGroup",
                    scanId);

                const response = await fetch(
                    `?handler=StartScan&id=${scanId}`,
                    {
                        method: "POST",
                        headers: {
                            "RequestVerificationToken":
                                document.querySelector(
                                    'input[name="__RequestVerificationToken"]'
                                ).value
                        }
                    });

                if (!response.ok) {
                    throw new Error(
                        "Tarama başlatılamadı.");
                }

                window.location.href =
                    `/ScanDetail?id=${scanId}`;
            }
            catch (error) {
                console.error(
                    "SignalR tarama hatası:",
                    error);
            }
        });
    </script>
}